# Copy this file to .env and fill in your key. .env is gitignored — never commit it.

# Required. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Optional. Defaults to a zero-cost model.
# BUDGET_AGENT_MODEL=openrouter:inclusionai/ling-3.0-flash:free

# Optional — LangSmith tracing. No code changes needed, these vars alone
# turn it on. Get a key at https://smith.langchain.com
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=budget-agent
