# =============================================================================
# Travel_Agency -- example environment file
#
# Copy to .env at the repo root and fill in real values. Never commit .env.
# Placeholders only in this file. Every agent loads this one root .env.
#
# Every variable below was found by grepping the code for os.getenv /
# os.environ.get / os.environ[ / os.environ.setdefault, or is consumed
# implicitly by a library that the code constructs. Nothing here is
# speculative -- if a name is not read anywhere, it is not in this file.
#
# See ENVIRONMENT.md for the full table and the non-env prerequisites.
#
# NOTHING BELOW IS NEEDED to run the orchestrator or the Chainlit UI on their
# default settings. That path uses deterministic stand-ins for every slot and
# requires zero credentials (verified: ENVIRONMENT.md).
# =============================================================================


# -----------------------------------------------------------------------------
# MODELS  (llm_config.py -- every agent's chat model)
# -----------------------------------------------------------------------------
# Each agent's model is an init_chat_model string, provider first. First match
# wins: the agent's own variable, then LLM_MODEL, then ollama:qwen3:8b.
# Everything in this section is optional.

# --- Option 1 (default): Ollama on this machine. No LLM key needed.
# Install Ollama, then: ollama pull qwen3:8b
# LLM_MODEL=ollama:qwen3:8b
# These apply to ollama: models only; the values shown are the in-code defaults.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_NUM_CTX=8192
# LLM_TEMPERATURE=0
#
# Model "thinking" (true/false, or a level like low). Each agent's own setting
# wins, then OLLAMA_REASONING, then the default: on for the orchestrator only.
# Measured on qwen3:8b with an 8 GB GPU: with thinking off, the agent-mode
# orchestrator's tool calls come back unparseable and no agent gets called;
# with thinking on for the subagents, calls ran ~10x slower, Flights searched
# the wrong year, and Money & Customs' prompt neared OLLAMA_NUM_CTX.
# ORCHESTRATOR_REASONING=true
# DESTINATION_REASONING=false
# FLIGHTS_REASONING=false
# FLIGHTS_REASONING=true is an option: it fixes Flights on open-ended questions
# ("What should I know? Break it down..."), where with thinking off Flights may
# return no results, but Flights takes ~50-95 s per call on qwen3:8b, 8 GB GPU.
# MONEY_AGENT_REASONING=false
# OLLAMA_REASONING=

# --- Option 2: another local server with an OpenAI-compatible API
# (LM Studio, vLLM, llama.cpp server). Needs: pip install langchain-openai
# Use the model name the server reports. No key needed for a local server.
# LLM_MODEL=openai:qwen2.5-7b-instruct
# LLM_BASE_URL=http://127.0.0.1:1234/v1

# --- Option 3: a hosted API. Set the matching key under HOSTED MODELS below.
# LLM_MODEL=anthropic:claude-haiku-4-5
# LLM_MODEL=openrouter:openai/gpt-4o-mini
# LLM_MODEL=cohere:command-r-plus-08-2024
# Hosted models get no temperature unless LLM_TEMPERATURE is set (the
# Anthropic API rejects one for some models).

# --- Mixing: per-agent overrides win over LLM_MODEL for that one agent.
# Example: everything local except Flights on OpenRouter.
# LLM_MODEL=ollama:qwen3:8b
# FLIGHTS_MODEL=openrouter:openai/gpt-4o-mini
# The four per-agent names:
# DESTINATION_MODEL=
# FLIGHTS_MODEL=
# MONEY_AGENT_MODEL=
# ORCHESTRATOR_MODEL=

# Output ceiling for the Flights slot (subagent_client.py).
# TRAVEL_UI_MAX_TOKENS=2048


# -----------------------------------------------------------------------------
# FLIGHTS  (flights_agent.py)
# -----------------------------------------------------------------------------
# REQUIRED for real flight prices. Read at flights_agent.py:29. Without it the
# search tool returns "Flight search unavailable: TRAVELPAYOUTS_TOKEN is not
# set in .env." -- the import does not fail.
# Get one: log in -> Profile -> API token. The airport-code lookup needs no
# token; only the price search does.
TRAVELPAYOUTS_TOKEN=your-travelpayouts-token-here


# -----------------------------------------------------------------------------
# DESTINATION  (destination_agent/)
# -----------------------------------------------------------------------------
# OPTIONAL -- powers the Geoapify geocode/places tools
# (destination_agent/geoapify_data.py:23). Guarded: without it the tools
# return {"error": "GEOAPIFY_API_KEY is not configured in the .env file."}
# The agent still answers from its local corpus, so this is silent
# degradation, not a crash.
GEOAPIFY_API_KEY=your-geoapify-key-here


# -----------------------------------------------------------------------------
# HOSTED MODELS  -- optional, only if you point an agent at one
# -----------------------------------------------------------------------------
# Not needed on the default Ollama setup. Each is read by its provider's
# LangChain integration when a *_MODEL / LLM_MODEL value above names that
# provider, e.g. LLM_MODEL=anthropic:claude-haiku-4-5.
# The Money & Customs tools (money_tools.py) call keyless public APIs either way.
# ANTHROPIC_API_KEY=your-anthropic-key-here
# COHERE_API_KEY=your-cohere-key-here
# OPENROUTER_API_KEY=sk-or-your-key-here


# =============================================================================
# BEHAVIOUR FLAGS -- optional, not credentials, not model strings
# =============================================================================

# Chainlit UI: which agent slots run real vs stand-in, without editing code.
# Read in ui/agent_seam.py (ENV_VAR). Comma-separated slot=mode pairs. Slots:
# destination, flights, money_customs. Modes: real, dummy. Unrecognised pairs
# are ignored. Defaults live in ui/agent_seam.py:MODES -- every slot dummy.
#
# Setting a slot to `real` means that agent needs its model (Ollama running,
# model pulled) and, for Flights prices, TRAVELPAYOUTS_TOKEN.
# TRAVEL_UI_AGENTS=destination=real,flights=real,money_customs=real

# Orchestrator: the fixed pipeline (default) or a model that decides who to
# call. Read in orchestrator.plan_trip.
# TRAVEL_UI_ORCHESTRATOR=agent


# =============================================================================
# LANGSMITH TRACING -- optional, and NOT read by any code in this repo
#
# No file in this repository reads these. They are consumed directly by the
# langsmith/langchain libraries when present. When tracing is on, run traces
# (prompts, tool calls, replies) are sent to LangSmith's hosted service.
# =============================================================================
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_your-key-here
# LANGSMITH_PROJECT=travel-agency
