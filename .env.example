# =============================================================================
# Travel_Agency -- example environment file
#
# Copy to .env at the repo root and fill in real values. Never commit .env.
# Placeholders only in this file.
#
# Every variable below was found by grepping the code for os.getenv /
# os.environ.get / os.environ[ / os.environ.setdefault, or is consumed
# implicitly by a provider SDK that the code constructs. Nothing here is
# speculative -- if a name is not read anywhere, it is not in this file.
#
# See ENVIRONMENT.md for the full table, the import-time-crash list, the
# non-env prerequisites, and the minimum set needed to run each piece.
#
# NOTHING BELOW IS NEEDED to run the orchestrator or the Chainlit UI on their
# default settings. That path uses deterministic stand-ins for every slot and
# requires zero credentials (verified: ENVIRONMENT.md).
# =============================================================================


# -----------------------------------------------------------------------------
# FLIGHTS  (flights_agent.py)
# -----------------------------------------------------------------------------
# REQUIRED -- and required at IMPORT time, not first call. flights_agent.py:29
# reads it with a bare subscript, os.environ["TRAVELPAYOUTS_TOKEN"], so
# `import flights_agent` raises KeyError if this is unset. This is the only
# variable in the repo that can take down a module on import.
#
# Where to get it, per the module docstring (flights_agent.py:17-18):
#   "Requires in .env: TRAVELPAYOUTS_TOKEN / Get one: log in -> Profile -> API token"
# The airport-code lookup endpoint needs no token; only the price search does.
TRAVELPAYOUTS_TOKEN=your-travelpayouts-token-here


# -----------------------------------------------------------------------------
# DESTINATION  (destination_agent/)
# -----------------------------------------------------------------------------
# REQUIRED for the Destination agent. Not read by an os.getenv call -- it is
# consumed by ChatAnthropic, which destination_agent.py:346 constructs at
# MODULE level, so a missing key surfaces on `import destination_agent`
# rather than on first request. The package docstring says so explicitly
# (destination_agent/__init__.py:14-16).
ANTHROPIC_API_KEY=your-anthropic-key-here

# OPTIONAL -- powers the Geoapify geocode/places tools
# (destination_agent/geoapify_data.py:23). Guarded: without it the tools
# return {"error": "GEOAPIFY_API_KEY is not configured in the .env file."}
# (geoapify_data.py:56-58, :174-176). The agent still answers from its local
# corpus, so this is silent degradation, not a crash.
GEOAPIFY_API_KEY=your-geoapify-key-here


# -----------------------------------------------------------------------------
# MONEY & CUSTOMS  (money_customs_agent.py -- the variant the orchestrator wires)
# -----------------------------------------------------------------------------
# REQUIRED for the real Money & Customs agent. orchestrator_config.py:79 does
# `from money_customs_agent import answer`, and that module builds ChatCohere
# (money_customs_agent.py:102).
#
# NOTE: money_customs_agent.py:24 calls os.environ.setdefault with a
# placeholder string, so the variable is never technically "missing" -- an
# unset key shows up as a Cohere authentication error at first call, not as a
# clear "key not configured" message. See ENVIRONMENT.md, team discussion item.
#
# The exchange-rate, income-context and money-customs tools themselves
# (money_tools.py) call keyless public APIs and need nothing here.
COHERE_API_KEY=your-cohere-key-here


# -----------------------------------------------------------------------------
# OPENROUTER  (the Flights slot's model and the agentic orchestrator)
# -----------------------------------------------------------------------------
# REQUIRED for the real Flights slot: orchestrator_config.py:46 runs it on
# openrouter:openai/gpt-4o-mini. Also used by orchestrator_agent.py:42 when
# TRAVEL_UI_ORCHESTRATOR=agent, whose default model is an openrouter: slug.
# Source: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-your-key-here


# =============================================================================
# MODEL-SELECTION OVERRIDES -- all optional, all have in-code defaults
#
# These are not credentials. Every one of them is `os.environ.get(NAME,
# "<default>")`, so leaving them unset is the supported case. Left commented
# out deliberately: setting them is the exception, not the norm.
#
# The default literals are quoted from the code. Whether a given slug still
# resolves on its provider is UNVERIFIED -- confirming that needs a live
# billed call, which is out of scope for this file.
# =============================================================================

# Money & Customs. money_customs_agent.py:32 defaults to a Cohere model.
# MONEY_AGENT_MODEL=command-r-plus-08-2024


# =============================================================================
# BEHAVIOUR FLAGS -- optional, not credentials, not model strings
# =============================================================================

# Chainlit UI: which agent slots run real vs stand-in, without editing code.
# Read at ui/agent_seam.py:133 (name defined :104). Comma-separated
# slot=mode pairs. Slots: destination, flights, money_customs. Modes: real,
# dummy. Unrecognised pairs are ignored -- including the removed `direct`
# mode. Defaults live in ui/agent_seam.py:MODES -- every slot dummy.
#
# Setting a slot to `real` means that agent's credentials above become
# required. This is the switch that turns a zero-credential demo into one that
# needs keys.
# TRAVEL_UI_AGENTS=flights=real,destination=real


# =============================================================================
# LANGSMITH TRACING -- optional, and NOT read by any code in this repo
#
# No file in this repository reads these. They are consumed directly by the
# langsmith/langchain libraries when present. Listed because a committed
# example file documents them (destination_agent/.env.example:3-5) and
# people will otherwise wonder where they went.
# =============================================================================
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_your-key-here
# LANGSMITH_PROJECT=travel-agency
