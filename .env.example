# =============================================================================
# Travel_Agency -- example environment file
#
# Copy to .env at the repo root and fill in real values. Never commit .env.
# Placeholders only in this file.
#
# Every variable below was found by grepping the code for os.getenv /
# os.environ.get / os.environ[ / os.environ.setdefault, or is consumed
# implicitly by a provider SDK that the code constructs. Nothing here is
# speculative -- if a name is not read anywhere, it is not in this file.
#
# See ENVIRONMENT.md for the full table, the import-time-crash list, the
# non-env prerequisites, and the minimum set needed to run each piece.
#
# NOTHING BELOW IS NEEDED to run the orchestrator or the Chainlit UI on their
# default settings. That path uses deterministic stand-ins for every slot and
# requires zero credentials (verified: ENVIRONMENT.md).
# =============================================================================


# -----------------------------------------------------------------------------
# FLIGHTS  (flights_agent.py)
# -----------------------------------------------------------------------------
# REQUIRED -- and required at IMPORT time, not first call. flights_agent.py:29
# reads it with a bare subscript, os.environ["TRAVELPAYOUTS_TOKEN"], so
# `import flights_agent` raises KeyError if this is unset. This is the only
# variable in the repo that can take down a module on import.
#
# Where to get it, per the module docstring (flights_agent.py:17-18):
#   "Requires in .env: TRAVELPAYOUTS_TOKEN / Get one: log in -> Profile -> API token"
# The airport-code lookup endpoint needs no token; only the price search does.
TRAVELPAYOUTS_TOKEN=your-travelpayouts-token-here


# -----------------------------------------------------------------------------
# DESTINATION  (destination_agent/)
# -----------------------------------------------------------------------------
# REQUIRED for the Destination agent. Not read by an os.getenv call -- it is
# consumed by ChatAnthropic, which destination_agent.py:346 constructs at
# MODULE level, so a missing key surfaces on `import destination_agent`
# rather than on first request. The package docstring says so explicitly
# (destination_agent/__init__.py:14-16).
ANTHROPIC_API_KEY=your-anthropic-key-here

# OPTIONAL -- powers the Geoapify geocode/places tools
# (destination_agent/geoapify_data.py:23). Guarded: without it the tools
# return {"error": "GEOAPIFY_API_KEY is not configured in the .env file."}
# (geoapify_data.py:56-58, :174-176). The agent still answers from its local
# corpus, so this is silent degradation, not a crash.
GEOAPIFY_API_KEY=your-geoapify-key-here


# -----------------------------------------------------------------------------
# MONEY & CUSTOMS  (money_customs_agent.py -- the variant the orchestrator wires)
# -----------------------------------------------------------------------------
# REQUIRED for the real Money & Customs agent. orchestrator_config.py:79 does
# `from money_customs_agent import answer`, and that module builds ChatCohere
# (money_customs_agent.py:102).
#
# NOTE: money_customs_agent.py:24 calls os.environ.setdefault with a
# placeholder string, so the variable is never technically "missing" -- an
# unset key shows up as a Cohere authentication error at first call, not as a
# clear "key not configured" message. See ENVIRONMENT.md, team discussion item.
#
# The exchange-rate, income-context and money-customs tools themselves
# (money_tools.py) call keyless public APIs and need nothing here.
COHERE_API_KEY=your-cohere-key-here


# -----------------------------------------------------------------------------
# BUDGET
# -----------------------------------------------------------------------------
# Two Budget implementations exist in the tree and they read different vars.
#
# (a) budget_agent/ (Shashank's, on main). Needs ONE of the two keys below.
#     ANTHROPIC_API_KEY wins if set; otherwise OPENROUTER_API_KEY
#     (budget_agent/config.py:30-41). With neither, load_settings() raises
#     RuntimeError at first build_agent() call -- runtime, not import.
#     Source URLs come from that error message itself (config.py:47-48):
#       ANTHROPIC_API_KEY  -> https://console.anthropic.com/settings/keys
#       OPENROUTER_API_KEY -> https://openrouter.ai/settings/keys
#     Careful: config.py:34 and :39 treat a key still holding its placeholder
#     prefix ("sk-ant-your-key-here" / "sk-or-your-key-here") as ABSENT.
#
# (b) budget_agent_rohan/ (not on main). Its default model slug is an
#     OpenRouter one, so it needs OPENROUTER_API_KEY
#     (budget_agent_rohan/proposed_envelope_agent/agent.py:260, :232).
#     Source per budget_agent_rohan/.env.example:3 -> https://openrouter.ai/keys
#
# OPENROUTER_API_KEY is the closest thing this repo has to a single shared
# credential: Budget, Activities, the Restaurants paid fallback, the Flights
# in-file agent (flights_agent.py:192) and subagent_client.py:81 all default
# to openrouter: model slugs.
OPENROUTER_API_KEY=sk-or-your-key-here


# -----------------------------------------------------------------------------
# ACTIVITIES  (activities/local_activity_docs/ and activities-agent-limeng/)
# -----------------------------------------------------------------------------
# Neither Activities variant is merged to main.
#
# OPTIONAL -- OpenTripMap is the tier-3 fallback for cities the local corpus
# does not cover. Read at activities/local_activity_docs/mcp_opentripmap_server.py:15
# and passed into the MCP subprocess environment at
# activities/local_activity_docs/activities_agent.py:200. Guarded: without it
# the tool returns {"error": "OPENTRIPMAP_API_KEY is not set in the
# environment."} (mcp_opentripmap_server.py:39-40) and tiers 1-2 still work.
#
# Source per activities-agent-limeng/activities_agent.py:56: "free, from
# dev.opentripmap.org".
OPENTRIPMAP_API_KEY=your-opentripmap-key-here

# Activities also needs OPENROUTER_API_KEY (above) unless DEEP_AGENT_MODEL is
# pointed at a local model -- its default slug is an openrouter: one.


# -----------------------------------------------------------------------------
# RESTAURANTS  (restaurant_agent/)
# -----------------------------------------------------------------------------
# No credential of its own. The default model is local Ollama and the live
# corpus expansion uses keyless OpenStreetMap endpoints (Overpass and
# Nominatim -- restaurants_live.py:46, :92). A key is only needed if you
# override RESTAURANT_AGENT_MODEL to an openrouter: slug, in which case
# OPENROUTER_API_KEY above applies. This matches restaurant_agent/.env.template.


# =============================================================================
# MODEL-SELECTION OVERRIDES -- all optional, all have in-code defaults
#
# These are not credentials. Every one of them is `os.environ.get(NAME,
# "<default>")`, so leaving them unset is the supported case. Left commented
# out deliberately: setting them is the exception, not the norm.
#
# The default literals are quoted from the code. Whether a given slug still
# resolves on its provider is UNVERIFIED -- confirming that needs a live
# billed call, which is out of scope for this file.
# =============================================================================

# Money & Customs. NOTE: one name, two different agents, two different
# providers' defaults -- money_customs_agent.py:32 defaults to a Cohere model,
# the unwired agent.py:31 defaults to a Cerebras one. Setting this affects
# whichever module you import.
# MONEY_AGENT_MODEL=command-r-plus-08-2024

# Budget, Rohan's variant. budget_agent_rohan/proposed_envelope_agent/agent.py:260,
# default DEFAULT_MODEL at :232.
# BUDGET_AGENT_MODEL=openrouter:openai/gpt-oss-20b:free

# Budget, Shashank's variant. Only one of these two applies, depending on
# which provider config.py selected. budget_agent/config.py:35 and :40.
# ANTHROPIC_MODEL=claude-sonnet-4-6
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Restaurants. restaurant_agent/restaurant_agent_ollama.py:96. The default is
# a free local model; :99 lists ollama:granite4.1:3b as a lighter alternative.
# RESTAURANT_AGENT_MODEL=ollama:lfm2.5

# Activities chat model. Read by both variants --
# activities/local_activity_docs/activities_agent.py:187 and
# activities-agent-limeng/activities_agent.py:78.
# DEEP_AGENT_MODEL=openrouter:z-ai/glm-5.2

# Activities embedding model, Jainam's variant only. Read at
# activities/local_activity_docs/activities_agent.py:61 and
# build_vector_index.py:22. Must be a model pulled into local Ollama.
# OLLAMA_EMBED_MODEL=nomic-embed-text


# =============================================================================
# BEHAVIOUR FLAGS -- optional, not credentials, not model strings
# =============================================================================

# Restaurants: live corpus expansion for an uncovered city. ON by default.
# restaurant_finder.py:544-545 -- any of 0/false/no/off turns it off, and with
# it off an uncovered city degrades to the coverage refusal instead of being
# fetched live.
# RESTAURANT_AGENT_LIVE_EXPANSION=1

# Chainlit UI: which agent slots run real vs stand-in, without editing code.
# Read at ui/agent_seam.py:133 (name defined :104). Comma-separated
# slot=mode pairs. Slots: destination, flights, restaurants, activities,
# budget, money_customs. Modes: real, dummy. Unrecognised pairs are ignored --
# including the removed `direct` mode. Defaults live in ui/agent_seam.py:MODES
# -- every slot dummy.
#
# Setting a slot to `real` means that agent's credentials above become
# required. This is the switch that turns a zero-credential demo into one that
# needs keys.
# TRAVEL_UI_AGENTS=flights=real,destination=real


# =============================================================================
# LANGSMITH TRACING -- optional, and NOT read by any code in this repo
#
# No file in this repository reads these. They are consumed directly by the
# langsmith/langchain libraries when present. Listed because two committed
# example files document them (destination_agent/.env.example:3-5,
# budget_agent_rohan/.env.example:9-13) and people will otherwise wonder
# where they went.
# =============================================================================
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_your-key-here
# LANGSMITH_PROJECT=travel-agency


# =============================================================================
# NOT WIRED INTO THE PIPELINE -- kept for accuracy, not because you need it
#
# CEREBRAS_API_KEY is read only by agent.py (agent.py:23), an earlier Money &
# Customs variant built on Cerebras. Nothing imports it: the orchestrator
# reaches Money & Customs through money_customs_agent (orchestrator_config.py:79),
# and no other module in the tree imports agent.py.
#
# It was the ONLY variable in the previous version of this file. Retained here
# rather than deleted, since the read site is real -- but do not treat it as
# something the system needs. Set it only if you are running agent.py directly.
#
# Same shape as COHERE_API_KEY: agent.py:23 uses os.environ.setdefault with a
# placeholder ("KEYKEYKEY_THISISWHEREITGOES"), so an unset key looks like a
# Cerebras auth failure rather than a missing-config error.
#
# Source, carried over verbatim from the previous version of this file:
# "free tier available at cloud.cerebras.ai".
# =============================================================================
# CEREBRAS_API_KEY=your-cerebras-key-here
